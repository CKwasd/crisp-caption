// ============================================================
// crisp-caption profile — 本機模式範例
// 這是 JSONC：// 或 /* ... */ 是註解，載入時自動忽略。
// ============================================================
{
  // --- 基本 ---
  "name": "Japanese stable example",
  "description": "Example profile for steadier Japanese live subtitles. Copy to profile.ja.json. Partial throttle enabled.",
  "tags": ["live", "stable", "ja", "example"],

  // bridge 伺服器監聽位置（瀏覽器 UI 連這個）
  "host": "127.0.0.1",
  "port": 8765,

  // --- ASR（語音辨識）---
  // CrispASR 執行檔路徑（本機模式用）
  "crispasr": "tools/crispasr/crispasr.exe",

  // 直接透傳給 CrispASR 的 CLI 參數
  // 必要：--backend、-l（語言）、-m（模型）、--vad、-vm（VAD 模型）
  // 其餘 --stream-*、-v* 是串流/VAD 調校（不同 profile 的差異主要在這）
  "crisp_args": [
    "--backend", "cohere",
    "-l", "ja",
    "-m", "../models/asr/cohere-asr-ja-q6_k.gguf",
    "--stream-json",
    "--stream-final-mode", "redecode",
    "--stream-utterance-max-sec", "60",
    "--stream-final-on-silence-ms", "300",
    "--stream-vad-merge-gap-ms", "250",
    "--stream-length", "8000",
    "--stream-step", "750",
    "--stream-partial-decode-ms", "1500",
    "--vad",
    "-vm", "../models/vad/firered-vad.gguf",
    "-vt", "0.70",
    "-vspd", "180",
    "-vsd", "330",
    "-vmsd", "10",
    "-vp", "110"
  ],

  // --- 翻譯 ---
  // 翻譯模型（對應翻譯伺服器啟動時的模型 alias）
  "translate_model": "Hy-MT2-1.8B",

  // 翻譯端點（本機 llama-server 或遠端 Colab 的 OpenAI 相容位址）
  "translate_url": "http://127.0.0.1:8080/v1/chat/completions",

  // 用多少筆最近翻譯當上下文
  "translate_window": 8,

  // 翻譯抽樣參數
  "temperature": 0.7,
  "top_k": 20,
  "top_p": 0.6,
  "repeat_penalty": 1.05,
  "max_tokens": 4096,   // 單次輸出上限

  // 附加檔案（可選）
  "translate_prompt_file": "",  // 自訂翻譯 prompt（檔名）
  "glossary_file": "",          // 術語表 JSON（強制特定譯法）

  // --- Overlay（字幕顯示）---
  "overlay_mode": "both",         // 顯示模式：source | trans | both
  "overlay_interj_len": 3,        // 多短的尾句算插入語（字元數）
  "overlay_interj_ratio": 0.4,    // 合併門檻（相對前句長度的比例）
  "overlay_interj_gap_sec": 2.0   // 跟前一句最大間隔（秒）
}
